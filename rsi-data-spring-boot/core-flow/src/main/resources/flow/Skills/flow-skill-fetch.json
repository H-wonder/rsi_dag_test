      "results": [
        { "title": "结果", "name": "result", "type": "String", "notnull": false }
      ]
    }
  ],
  "routes": [
    { "source": "start", "target": "FLOW_NODE_FETCH", "condition": "true" },
    { "source": "FLOW_NODE_FETCH", "target": "end", "condition": "true" }
